# === CrowdWisdomTrading Configuration ===

# Apify - X (Twitter) post collection
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=apidojo/tweet-scraper
APIFY_MAX_ITEMS=1000
APIFY_TIMEOUT_SECONDS=180

# Tavily - News search
TAVILY_API_KEY=your_tavily_api_key_here

# Exa - Additional news search
EXA_API_KEY=your_exa_api_key_here

# Database
DATABASE_PATH=data/crowdwisdom.db

# Defaults
DEFAULT_ASSET=BTCUSDT
DEFAULT_TIMEFRAME=1d
HISTORY_DAYS=180

# Sentiment
SENTIMENT_MODEL=hybrid
ENABLE_TRANSFORMER_SENTIMENT=true

# ML
RANDOM_STATE=42

# Trading
TRANSACTION_COST_BPS=10
